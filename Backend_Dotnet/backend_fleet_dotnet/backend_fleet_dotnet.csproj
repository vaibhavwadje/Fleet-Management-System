<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FleetManagement</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- API + Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- EF Core against the SAME MySQL database the Java backend uses.
         Pomelo is the maintained MySQL provider for EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />

    <!-- Requirement 2: JWT bearer authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.2" />

    <!-- Google Sign-In. The OAuth2 handshake only; the session that comes out
         of it is one of OUR JWTs, exactly as on the Java side. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.8" />

    <!-- Requirement 1: structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Requirement 10: object-to-object mapping.
         12.0.1 of the DI package pairs with AutoMapper 12.x. Do not bump
         AutoMapper to 13 without dropping the DI package - 13 registers
         itself and the two together cause a duplicate-registration error. -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

    <!-- Requirement 6: server-side validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />

    <!-- Password hashing that reads the Java backend's BCrypt $2a$ hashes -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Native SMTP. Replaces delegating e-mail to the Java service, which
         was never actually possible - Java exposes no send endpoint.
         MailKit rather than System.Net.Mail.SmtpClient: the latter is
         documented as obsolete for new code and handles STARTTLS poorly. -->
    <PackageReference Include="MailKit" Version="4.7.1.1" />
  </ItemGroup>

</Project>
